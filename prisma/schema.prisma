generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- کاربران و دسترسی‌ها ----------

enum UserRole {
  SUPER_ADMIN // مدیر کل
  UNIT_MANAGER // مدیر واحد
  THERAPIST // درمانگر یا کارشناس
  STAFF // پذیرش و پشتیبانی
  TEACHER // مدرس یا همکار آموزشی
  EXTERNAL // کاربر بیرونی
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

// وضعیت بررسی درخواست ثبت‌نام — ورود فقط پس از تأیید مدیر مجاز است
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  username         String?    @unique // کد ملی — نام کاربری جایگزین ایمیل برای ورود
  passwordHash     String
  name             String
  role             UserRole   @default(STAFF)
  unit             String     @default("عمومی") // واحد سازمانی
  jobTitle         String     @default("")
  phone            String     @default("")
  province         String     @default("") // استان
  clinic           String     @default("") // کلینک محل خدمت (متن — سازگاری با سامانه‌ها)
  education        String     @default("") // مدرک تحصیلی
  workLicense      String     @default("") // پروانه اشتغال (دارد / ندارد)
  profRank         String     @default("") // رتبه حرفه‌ای
  contractNo       String     @default("") // شماره قرارداد
  provinceCode     String     @default("") // کد استان‌ها
  personalCode     String     @default("") // کد تفضیلی شخص
  bankSheba        String     @default("") // شماره شبا بانکی
  avatarColor      String     @default("#c2185b")
  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // اطلاعات پایه سازمانی — فاز ۷۲
  centerId     String? // مرکز تخصیص — از اطلاعات پایه مراکز
  clinicId     String? // کلینک خدمت — از اطلاعات پایه مراکز
  managementId String? // مدیریت متبوع
  managerId    String? // مدیر مستقیم (سلسله‌مراتب سازمانی)

  center             Center?      @relation("userCenter", fields: [centerId], references: [id], onDelete: SetNull)
  clinicCenter       Center?      @relation("userClinic", fields: [clinicId], references: [id], onDelete: SetNull)
  management         Management?  @relation("managementMembers", fields: [managementId], references: [id], onDelete: SetNull)
  manager            User?        @relation("orgTree", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       User[]       @relation("orgTree")
  managedCenters     Center[]     @relation("centerManager")
  managedManagements Management[] @relation("managementManager")

  systemAccess     SystemAccess[]
  sessions         Session[]
  tasksAssigned    Task[]               @relation("assignee")
  tasksCreated     Task[]               @relation("creator")
  announcements    Announcement[]
  announcementAcks AnnouncementAck[]
  eventsOwned      CalendarEvent[]
  eventAttendances EventAttendee[]
  notes            Note[]
  noteShares       NoteShare[]
  conversations    ConversationMember[]
  messages         Message[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  taskComments     TaskComment[]
  reportFiles      ReportFile[]
  excelDatasets    ExcelDataset[]
  customIndicators CustomIndicator[]
  pagePermissions  PagePermission[]

  // ثبت‌نام و بات بله
  reviewedRegistrations RegistrationRequest[] @relation("RegistrationReviewer")
  baleLink              BaleLink?
  passwordResets        PasswordResetToken[]
}

// ---------- اطلاعات پایه: مراکز و کلینیک‌ها ----------

// مرکز یا کلینیک — اطلاعات پایهٔ سازمانی؛ از سامانهٔ حضور و غیاب (تکنورز)
// قابل همگام‌سازی است و در فرم کاربران به‌صورت کمبوباکس استفاده می‌شود.
model Center {
  id        String   @id @default(cuid())
  code      String   @unique // کد مرکز — کلید همگام‌سازی با سامانهٔ حضور و غیاب
  name      String
  type      String   @default("CLINIC") // CENTER = مرکز، CLINIC = کلینیک، HQ = ستاد
  region    String   @default("") // منطقه / حوزه
  province  String   @default("")
  county    String   @default("") // شهرستان — سطح بین استان و شهر برای سلسله‌مراتب
  city      String   @default("")
  address   String   @default("")
  phone     String   @default("")
  lat       Float? // عرض جغرافیایی — نمایش روی نقشه
  lng       Float? // طول جغرافیایی — نمایش روی نقشه
  radiusM   Int      @default(300) // شعاع مجاز تردد به متر (مانند سامانهٔ حضور و غیاب)
  isActive  Boolean  @default(true)
  source    String   @default("MANUAL") // MANUAL / TECHNORZ — منشأ رکورد
  managerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager     User?        @relation("centerManager", fields: [managerId], references: [id], onDelete: SetNull)
  users       User[]       @relation("userCenter")
  clinics     User[]       @relation("userClinic")
  managements Management[]
  mgLinks     ManagementCenter[]

  @@index([province])
  @@index([type])
}

// رابطهٔ چند‌به‌چند مدیریت سازمانی ↔ مراکز — یک مدیریت می‌تواند به هر تعداد
// مرکز/کلینیکِ فرم «مراکز و کلینیک‌ها» متصل باشد (فاز ۷۴)
model ManagementCenter {
  managementId String
  centerId     String
  createdAt    DateTime @default(now())

  management Management @relation(fields: [managementId], references: [id], onDelete: Cascade)
  center     Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@id([managementId, centerId])
  @@index([centerId])
}

// مدیریت سازمانی — بند ۴: ثبت مدیریت، کارکنان آن و تعیین مدیر مدیریت
model Management {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  centerId    String?
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  center  Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)
  manager User?   @relation("managementManager", fields: [managerId], references: [id], onDelete: SetNull)
  members User[]  @relation("managementMembers")
  links   ManagementCenter[]
}

// ---------- گزارش‌های اکسل (داشبورد چندماهه) ----------

// فایل اکسل بارگذاری‌شده در بخش گزارش‌ها — رکوردهای پارس‌شده برای داشبورد
model ReportFile {
  id           String   @id @default(cuid())
  name         String // نام فایل
  month        Int      @default(0) // ماه شمسی ۱..۱۲ — ۰ یعنی نامشخص
  year         Int      @default(0) // سال شمسی ۱۳xx/۱۴xx
  sheet        String   @default("") // شیت استفاده‌شده
  services     String   @default("[]") // فهرست خدمت‌ها (JSON)
  records      String   @default("[]") // رکوردهای سطح مشاور × ماه (JSON)
  summary      String   @default("{}") // خلاصهٔ مالی فایل (JSON)
  nConsultants Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([year, month])
}

// درخواست ثبت‌نام کاربر جدید — تا تأیید مدیر هیچ User ساخته نمی‌شود
model RegistrationRequest {
  id           String             @id @default(cuid())
  fullName     String
  nationalId   String             @unique // کد ملی — نام کاربری آینده
  mobile       String
  email        String             @default("")
  passwordHash String
  province     String             @default("")
  clinic       String             @default("")
  jobTitle     String             @default("")
  status       RegistrationStatus @default(PENDING)
  reviewNote   String             @default("")
  reviewedById String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  reviewedBy User? @relation("RegistrationReviewer", fields: [reviewedById], references: [id])
}

// اتصال حساب کاربر رز هاب به چت بات بله (@rosepro_bot)
model BaleLink {
  id        String   @id @default(cuid())
  chatId    String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// توکن یک‌بارمصرف تغییر رمز — از طریق بات بله تحویل گرفته می‌شود
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 توکن — توکن خام ذخیره نمی‌شود
  code      String // ۶ رقم — برای تطبیق ذهنی کاربر
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// پیام‌های پشتیبانی دریافتی از بات بله
model SupportTicket {
  id        String   @id @default(cuid())
  chatId    String   @default("")
  sender    String   @default("کاربر بات بله")
  subject   String   @default("پشتیبانی بات بله")
  content   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// دسترسی هر کاربر به هر سامانه
model SystemAccess {
  id        String   @id @default(cuid())
  userId    String
  systemId  String
  createdAt DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  system ClinicSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([userId, systemId])
}

// نشست‌های فعال (مدیریت دستگاه‌ها)
model Session {
  id        String   @id @default(cuid()) // jti داخل توکن
  userId    String
  device    String   @default("نامشخص")
  ip        String   @default("")
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- سامانه‌های مجموعه ----------

enum ConnectionLevel {
  BASIC // اتصال پایه: SSO و انتقال کاربر
  ADVANCED // اتصال پیشرفته: API و نمایش داده
}

model ClinicSystem {
  id              String          @id @default(cuid())
  name            String
  url             String
  description     String          @default("")
  icon            String          @default("Globe")
  color           String          @default("#c2185b")
  connectionLevel ConnectionLevel @default(BASIC)
  status          String          @default("متصل") // وضعیت پایش فنی
  clientId        String?         @unique // شناسه عمومی سامانه برای اتصال SSO
  clientSecret    String? // رمز مشترک اعتبارسنجی توکن SSO (فقط مدیر کل و تیم فنی سامانه)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  access  SystemAccess[]
  metrics SystemMetric[]
}

// آمار قابل دریافت از سامانه‌ها (نمونه برای اتصال پیشرفته)
model SystemMetric {
  id        String   @id @default(cuid())
  systemId  String
  label     String
  value     String
  updatedAt DateTime @default(now())

  system ClinicSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
}

// ---------- اطلاعیه‌ها ----------

enum Importance {
  NORMAL
  IMPORTANT
  URGENT
}

enum AudienceType {
  ALL
  UNIT
  ROLE
  USERS
}

model Announcement {
  id          String       @id @default(cuid())
  title       String
  content     String
  importance  Importance   @default(NORMAL)
  audience    AudienceType @default(ALL)
  audienceRef String       @default("") // نام واحد یا نقش یا شناسه‌های کاربر (جدا با ,)
  requiresAck Boolean      @default(false)
  pinned      Boolean      @default(false)
  publishAt   DateTime     @default(now())
  expireAt    DateTime?
  authorId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author User              @relation(fields: [authorId], references: [id])
  acks   AnnouncementAck[]
}

model AnnouncementAck {
  id             String    @id @default(cuid())
  announcementId String
  userId         String
  viewedAt       DateTime  @default(now())
  acknowledgedAt DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

// ---------- وظایف ----------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(NEW)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String
  creatorId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignee User          @relation("assignee", fields: [assigneeId], references: [id])
  creator  User          @relation("creator", fields: [creatorId], references: [id])
  comments TaskComment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- تقویم ----------

enum EventType {
  MEETING
  EVENT
  CLASS
  DEADLINE
  OTHER
}

enum RepeatType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model CalendarEvent {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  type        EventType  @default(MEETING)
  start       DateTime
  end         DateTime?
  allDay      Boolean    @default(false)
  location    String     @default("")
  repeat      RepeatType @default(NONE)
  ownerId     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner     User            @relation(fields: [ownerId], references: [id])
  attendees EventAttendee[]
}

model EventAttendee {
  id       String @id @default(cuid())
  eventId  String
  userId   String
  response String @default("PENDING") // PENDING / YES / NO / MAYBE

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ---------- یادداشت‌ها ----------

enum NoteType {
  PERSONAL
  SHARED
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  type      NoteType @default(PERSONAL)
  color     String   @default("#fde7ef")
  tags      String   @default("") // جدا با ,
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User        @relation(fields: [authorId], references: [id])
  shares NoteShare[]
}

model NoteShare {
  id     String @id @default(cuid())
  noteId String
  userId String

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
}

// ---------- گفتگوها و پیام‌ها ----------

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

model Conversation {
  id        String           @id @default(cuid())
  title     String           @default("") // برای گروه و کانال
  type      ConversationType @default(DIRECT)
  creatorId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachment     String   @default("")
  replyToId      String?
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
}

// ---------- اعلان‌ها ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info") // info / task / announcement / event / message
  title     String
  body      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- گزارش فعالیت (Audit) ----------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String   @default("")
  action    String
  entity    String   @default("")
  details   String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- داشبورد عمومی اکسل (هر ساختاری) — فاز ۷۳ ----------

// فایل اکسل بارگذاری‌شده با ساختار دلخواه — ستون‌ها خودکار تشخیص داده می‌شوند
model ExcelDataset {
  id           String   @id @default(cuid())
  name         String // نام فایل
  sheetNames   String   @default("[]") // نام شیت‌ها (JSON)
  activeSheet  String   @default("") // شیت پیش‌فرض
  columns      String   @default("[]") // [{name,type}] — type: number/text/date
  rows         String   @default("[]") // رکوردها (JSON — تا سقف مجاز)
  profile      String   @default("{}") // پروفایل آماری ستون‌ها (JSON)
  nRows        Int      @default(0) // تعداد رکوردهای ذخیره‌شده
  nRowsTotal   Int      @default(0) // تعداد کل رکوردهای فایل اصلی
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// شاخص سفارشی — فرمول محاسبه‌شده روی ستون‌های داده (سطح ردیف یا کل داده)
model CustomIndicator {
  id          String   @id @default(cuid())
  name        String
  formula     String
  kind        String   @default("ROW") // ROW = ستون محاسباتی، AGG = شاخص کل
  description String   @default("")
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

// دسترسی صفحات در سطح کاربر — کدام فرم/صفحه دیده شود یا نشود (فاز ۷۳)
model PagePermission {
  id      String  @id @default(cuid())
  userId  String
  pageKey String // کلید صفحه — src/lib/pages.ts
  allowed Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
  @@index([userId])
}
